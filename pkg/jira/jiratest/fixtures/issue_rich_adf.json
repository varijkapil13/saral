    "description": {
      "type": "doc",
      "version": 1,
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "The basket total is "
            },
            {
              "type": "text",
              "text": "recalculated",
              "marks": [
                {
                  "type": "strong"
                }
              ]
            },
            {
              "type": "text",
              "text": " before the line items are read, so an empty basket divides by zero. See "
            },
            {
              "type": "text",
              "text": "the checkout runbook",
              "marks": [
                {
                  "type": "link",
                  "attrs": {
                    "href": "https://example.atlassian.net/wiki/spaces/EX/pages/98304"
                  }
                },
                {
                  "type": "strong"
                }
              ]
            },
            {
              "type": "text",
              "text": " and the "
            },
            {
              "type": "text",
              "text": "basketTotal()",
              "marks": [
                {
                  "type": "code"
                }
              ]
            },
            {
              "type": "text",
              "text": " helper."
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 2
          },
          "content": [
            {
              "type": "text",
              "text": "Steps to reproduce"
            }
          ]
        },
        {
          "type": "bulletList",
          "content": [
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Sign in as a customer with no saved basket."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Open "
                    },
                    {
                      "type": "inlineCard",
                      "attrs": {
                        "url": "https://example.atlassian.net/browse/EX-2"
                      }
                    },
                    {
                      "type": "text",
                      "text": " and follow the linked route."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Ask "
                    },
                    {
                      "type": "mention",
                      "attrs": {
                        "id": "5b10ac8d82e05b22cc7d4ef5",
                        "text": "@user",
                        "accessLevel": ""
                      }
                    },
                    {
                      "type": "text",
                      "text": " to confirm the account state."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "panel",
          "attrs": {
            "panelType": "warning"
          },
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Do not retry the request: each attempt writes an orphaned order row."
                }
              ]
            }
          ]
        },
        {
          "type": "codeBlock",
          "attrs": {
            "language": "go"
          },
          "content": [
            {
              "type": "text",
              "text": "func basketTotal(items []Item) Money {\n\tvar sum Money\n\tfor _, it := range items {\n\t\tsum = sum.Add(it.Price)\n\t}\n\treturn sum.Div(len(items))\n}"
            }
          ]
        },
        {
