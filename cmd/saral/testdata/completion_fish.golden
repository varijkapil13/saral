# fish completion for saral. Load it with: saral completion fish | source
complete -c saral -e
complete -c saral -n '__fish_use_subcommand' -f -a 'assign comment completion doctor help issue open search transition version list board backlog sprints releases timeline plans settings'
complete -c saral -n '__fish_use_subcommand' -l glyphs -r -d 'unicode, nerd or ascii; unicode is the default, nerd needs a Nerd Font'
complete -c saral -n '__fish_use_subcommand' -l log -r -d 'write a debug log to this file; tokens and emails are redacted'
complete -c saral -n '__fish_use_subcommand' -l mouse -d 'enable mouse reporting'
complete -c saral -n '__fish_use_subcommand' -l poll -r -d 're-read the focused view every duration, e.g. 30s; off by default, and pauses when Jira rate-limits'
complete -c saral -n '__fish_use_subcommand' -l profile -r -d 'profile to use (default: $SARAL_PROFILE, then the active one)'
complete -c saral -n '__fish_use_subcommand' -l project -r -d 'project key to scope the session to; several capabilities are per-project'
complete -c saral -n '__fish_use_subcommand' -l scheme -r -d 'default, nord, dracula, solarized or gruvbox'
complete -c saral -n '__fish_use_subcommand' -l theme -r -d 'auto, dark, light or no-color'
complete -c saral -n '__fish_use_subcommand' -l version -d 'print the version and exit'
complete -c saral -n '__fish_seen_subcommand_from assign' -l log -r -d 'write a debug log to this file; tokens and emails are redacted'
complete -c saral -n '__fish_seen_subcommand_from assign' -l profile -r -d 'profile to use (default: $SARAL_PROFILE, then the active one)'
complete -c saral -n '__fish_seen_subcommand_from assign' -l project -r -d 'project key to scope the session to; several capabilities are per-project'
complete -c saral -n '__fish_seen_subcommand_from comment; and not __fish_seen_subcommand_from add' -f -a 'add'
complete -c saral -n '__fish_seen_subcommand_from comment; and __fish_seen_subcommand_from add' -l file -r -d 'a Markdown file to post; - reads stdin'
complete -c saral -n '__fish_seen_subcommand_from comment; and __fish_seen_subcommand_from add' -l log -r -d 'write a debug log to this file; tokens and emails are redacted'
complete -c saral -n '__fish_seen_subcommand_from comment; and __fish_seen_subcommand_from add' -s m -r -d 'the comment, in Markdown'
complete -c saral -n '__fish_seen_subcommand_from comment; and __fish_seen_subcommand_from add' -l profile -r -d 'profile to use (default: $SARAL_PROFILE, then the active one)'
complete -c saral -n '__fish_seen_subcommand_from comment; and __fish_seen_subcommand_from add' -l project -r -d 'project key to scope the session to; several capabilities are per-project'
complete -c saral -n '__fish_seen_subcommand_from completion; and not __fish_seen_subcommand_from bash zsh fish' -f -a 'bash zsh fish'
complete -c saral -n '__fish_seen_subcommand_from issue; and not __fish_seen_subcommand_from create view' -f -a 'create view'
complete -c saral -n '__fish_seen_subcommand_from issue; and __fish_seen_subcommand_from create' -l description-file -r -d 'a Markdown file for the description; - reads stdin'
complete -c saral -n '__fish_seen_subcommand_from issue; and __fish_seen_subcommand_from create' -l json -d 'print the new issue\'s key, ID and URL as JSON'
complete -c saral -n '__fish_seen_subcommand_from issue; and __fish_seen_subcommand_from create' -l log -r -d 'write a debug log to this file; tokens and emails are redacted'
complete -c saral -n '__fish_seen_subcommand_from issue; and __fish_seen_subcommand_from create' -l parent -r -d 'the parent issue\'s key, which a subtask type needs'
complete -c saral -n '__fish_seen_subcommand_from issue; and __fish_seen_subcommand_from create' -l profile -r -d 'profile to use (default: $SARAL_PROFILE, then the active one)'
complete -c saral -n '__fish_seen_subcommand_from issue; and __fish_seen_subcommand_from create' -l project -r -d 'project key to scope the session to; several capabilities are per-project'
complete -c saral -n '__fish_seen_subcommand_from issue; and __fish_seen_subcommand_from create' -l summary -r -d 'the summary'
complete -c saral -n '__fish_seen_subcommand_from issue; and __fish_seen_subcommand_from create' -l type -r -d 'the issue type, by name or ID as this project has it'
complete -c saral -n '__fish_seen_subcommand_from issue; and __fish_seen_subcommand_from view' -l json -d 'print the issue as JSON (docs/CLI.md has the schema)'
complete -c saral -n '__fish_seen_subcommand_from issue; and __fish_seen_subcommand_from view' -l log -r -d 'write a debug log to this file; tokens and emails are redacted'
complete -c saral -n '__fish_seen_subcommand_from issue; and __fish_seen_subcommand_from view' -l profile -r -d 'profile to use (default: $SARAL_PROFILE, then the active one)'
complete -c saral -n '__fish_seen_subcommand_from issue; and __fish_seen_subcommand_from view' -l project -r -d 'project key to scope the session to; several capabilities are per-project'
complete -c saral -n '__fish_seen_subcommand_from open' -l log -r -d 'write a debug log to this file; tokens and emails are redacted'
complete -c saral -n '__fish_seen_subcommand_from open' -l print -d 'print the link without opening it'
complete -c saral -n '__fish_seen_subcommand_from open' -l profile -r -d 'profile to use (default: $SARAL_PROFILE, then the active one)'
complete -c saral -n '__fish_seen_subcommand_from open' -l project -r -d 'project key to scope the session to; several capabilities are per-project'
complete -c saral -n '__fish_seen_subcommand_from search' -l fields -r -d 'comma-separated fields to print, by ID or by the name this site gives them'
complete -c saral -n '__fish_seen_subcommand_from search' -l json -d 'print the issues as JSON (docs/CLI.md has the schema)'
complete -c saral -n '__fish_seen_subcommand_from search' -l limit -r -d 'print at most this many issues'
complete -c saral -n '__fish_seen_subcommand_from search' -l log -r -d 'write a debug log to this file; tokens and emails are redacted'
complete -c saral -n '__fish_seen_subcommand_from search' -l profile -r -d 'profile to use (default: $SARAL_PROFILE, then the active one)'
complete -c saral -n '__fish_seen_subcommand_from search' -l project -r -d 'project key to scope the session to; several capabilities are per-project'
complete -c saral -n '__fish_seen_subcommand_from transition' -l field -r -d 'a field the transition\'s screen asks for, as Name=Value; repeat for more'
complete -c saral -n '__fish_seen_subcommand_from transition' -l log -r -d 'write a debug log to this file; tokens and emails are redacted'
complete -c saral -n '__fish_seen_subcommand_from transition' -l profile -r -d 'profile to use (default: $SARAL_PROFILE, then the active one)'
complete -c saral -n '__fish_seen_subcommand_from transition' -l project -r -d 'project key to scope the session to; several capabilities are per-project'
